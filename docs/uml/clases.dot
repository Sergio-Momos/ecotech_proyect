Empleado [pos="1000,760!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#29475A" BGCOLOR="white"><TR><TD BGCOLOR="#E7F0F4" ALIGN="CENTER"><B>Empleado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># _salario : float<BR ALIGN="LEFT"/># _fecha_inicio_contrato : date<BR ALIGN="LEFT"/># _proyectos : tuple[Proyecto, ...]<BR ALIGN="LEFT"/># _registros_tiempo : tuple[RegistroTiempo, ...]<BR ALIGN="LEFT"/># _usuario : Usuario | None<BR ALIGN="LEFT"/># _activo : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listar_proyectos() : tuple<BR ALIGN="LEFT"/>+ registrar_horas(fecha: date, horas_trabajadas: float,<BR ALIGN="LEFT"/>    descripcion: str, proyecto: Proyecto) : RegistroTiempo<BR ALIGN="LEFT"/>+ crear_usuario(password: str, rol: Rol) : Usuario<BR ALIGN="LEFT"/>+ activar() : None<BR ALIGN="LEFT"/>+ desactivar() : None<BR ALIGN="LEFT"/># _agregar_proyecto(proyecto: Proyecto) : None<BR ALIGN="LEFT"/># _quitar_proyecto(proyecto: Proyecto) : None<BR ALIGN="LEFT"/># _agregar_registro_tiempo(registro: RegistroTiempo) : None<BR ALIGN="LEFT"/># _limpiar_registros_tiempo() : None</TD></TR></TABLE>>];
Usuario [pos="1000,1220!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#29475A" BGCOLOR="white"><TR><TD BGCOLOR="#E7F0F4" ALIGN="CENTER"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># _id : int<BR ALIGN="LEFT"/># _username : str<BR ALIGN="LEFT"/># _password : str {solo escritura}<BR ALIGN="LEFT"/># _valor_password : str {hash}<BR ALIGN="LEFT"/># _rol : Rol<BR ALIGN="LEFT"/># _activo : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verificar_password(password: str) : bool<BR ALIGN="LEFT"/>+ generar_base_username(nombre_completo: str) : str {clase}<BR ALIGN="LEFT"/>+ reconstruir(id: int, username: str, password_hash: str,<BR ALIGN="LEFT"/>    rol: Rol, activo: bool = True) : Usuario {clase}<BR ALIGN="LEFT"/>+ activar() : None<BR ALIGN="LEFT"/>+ desactivar() : None</TD></TR></TABLE>>];
Rol [pos="1700,1220!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#29475A" BGCOLOR="white"><TR><TD BGCOLOR="#E7F0F4" ALIGN="CENTER"><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># _id : int | None<BR ALIGN="LEFT"/># _nombre : str<BR ALIGN="LEFT"/># _perfil_bd : str<BR ALIGN="LEFT"/># _permisos : frozenset[str]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregar_permiso(permiso: str) : None<BR ALIGN="LEFT"/>+ quitar_permiso(permiso: str) : None<BR ALIGN="LEFT"/>+ tiene_permiso(permiso: str) : bool<BR ALIGN="LEFT"/>+ recursos_humanos() : Rol {clase}<BR ALIGN="LEFT"/>+ empleado_estandar() : Rol {clase}<BR ALIGN="LEFT"/>+ ti() : Rol {clase}</TD></TR></TABLE>>];
Seguridad [pos="300,1220!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#29475A" BGCOLOR="white"><TR><TD BGCOLOR="#E7F0F4" ALIGN="CENTER"><B>Seguridad</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># _ITERACIONES : int = 100000<BR ALIGN="LEFT"/># _LARGO_SALT : int = 16</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ hashear_password(password: str) : str</U><BR ALIGN="LEFT"/><U>+ verificar_password(password: str, hash_guardado: str) : bool</U><BR ALIGN="LEFT"/><U>+ hash_busqueda(dato: str) : str</U><BR ALIGN="LEFT"/><U># _calcular_hash(password: str, salt: str) : str</U></TD></TR></TABLE>>];
