digraph Dominio {
graph [layout=neato, overlap=true, splines=true, outputorder=edgesfirst, bgcolor="white", pad=0.45, fontname="DejaVu Sans", fontsize=21, labelloc=t, label="EcoTech Solutions | Diagrama de clases actual
