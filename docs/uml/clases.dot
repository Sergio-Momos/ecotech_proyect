Proyecto [pos="1000,300!", label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#29475A" BGCOLOR="white"><TR><TD BGCOLOR="#E7F0F4" ALIGN="CENTER"><B>Proyecto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># _id : int | None<BR ALIGN="LEFT"/># _nombre : str<BR ALIGN="LEFT"/># _descripcion : str<BR ALIGN="LEFT"/># _fecha_inicio : date<BR ALIGN="LEFT"/># _empleados : tuple[Empleado, ...]<BR ALIGN="LEFT"/># _activo : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ asignar_empleado(empleado: Empleado) : None<BR ALIGN="LEFT"/>+ quitar_empleado(empleado: Empleado) : None<BR ALIGN="LEFT"/>+ activar() : None<BR ALIGN="LEFT"/>+ desactivar() : None</TD></TR></TABLE>>];
